# 3LG Main Site — Environment Variables
# Copy to .env and fill in.

# ─── Airtable ───
# Used for Founding 100 live counter + lead capture persistence.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_LEADS_TABLE=Leads
AIRTABLE_FOUNDING_TABLE=Founding100
# Field names inside the Founding 100 table:
AIRTABLE_FOUNDING_TOTAL_FIELD=Total
AIRTABLE_FOUNDING_CLAIMED_FIELD=Claimed

# ─── Stepper ───
# Fires on every lead capture. The hook URL below is live.
STEPPER_WEBHOOK_URL=https://hook.stepper.io/hook/9cc2f34666e3c60d9e51a47f739ea1d99f4247a15982372a2a30ffd3da4e42fe

# ─── Anthropic (optional, for downstream AI features) ───
ANTHROPIC_API_KEY=

# ─── Server ───
PORT=3005
NODE_ENV=production
